# 依赖与构建产物（本仓库子项目零运行时依赖，回归只用 node 内置模块）
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# 回归/临时产物
.regression-tmp/
.regression-tmp-*/
.regression-lock/

# Python 字节码（dsh-doc-suite 运行/py_compile 自动生成，不入库）
__pycache__/
*.pyc

# 杂项
*.log
*.tmp
*.lock
.DS_Store
Thumbs.db

# 专家库开发文档（design-v2 / handover / optlog-* / pre-release-audit）不入库（2026-09-14 使用者定）
modules/dsh-experts/docs/
*.bak-*

# 专家库能力层兜底索引：由本机 scripts/skill-index.mjs 生成，内容含本机绝对路径 → 不入库（2026-09-18 定）
modules/dsh-experts/experts/skills.auto.json

# dsh-doc-suite media runtime lock must be tracked (media-test asserts it; CI has no lock otherwise)
!modules/dsh-doc-suite/scripts/media/runtime/package-lock.json
