            "autofit": { "min_size_pt": 32, "max_lines": 2 }
          },
          {
            "role": "subtitle",
            "box": { "x": 0.8, "y": 4.4, "w": 9.6, "h": 0.98 },
            "text": { "size": "subtitle", "color": "text_on_dark", "bold": false, "align": "left", "valign": "top", "line_spacing": 1.3 },
            "autofit": { "min_size_pt": 16, "max_lines": 2 },
