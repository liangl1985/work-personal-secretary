        "inherits": "content_page",
        "background": "surface",
        "elements": [
          {
            "role": "grid",
            "box": { "x": 0.8, "y": 1.9, "w": 11.7333, "h": 1.6 },
            "cols": 4,
            "max_rows": 1,
            "gap_in": 0.3,
