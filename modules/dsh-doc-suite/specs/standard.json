          },
          {
            "role": "meta",
            "box": { "x": 0.8, "y": 6.3, "w": 8.4, "h": 0.38 },
            "text": { "size": "small", "color": "text_muted_on_dark", "bold": false, "align": "left", "valign": "middle" },
            "autofit": { "min_size_pt": 11, "max_lines": 1 },
            "optional": true
          }
