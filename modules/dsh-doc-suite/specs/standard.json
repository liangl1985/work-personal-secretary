      "body": {
        "latin": "微软雅黑",
        "ea": "微软雅黑"
      }
    },
    "allowed_fonts": [
      "微软雅黑",
      "仿宋"
    ],
    "sizes_pt": {
      "cover_title": 44,
      "section_title": 40,
      "slide_title": 32,
      "subtitle": 22,
      "card_title": 22,
      "body": 20,
      "card_body": 16,
      "small": 14,
      "page_no": 12,
      "icon": 28,
      "quote": 28,
      "kpi_value": 36,
      "table_header": 14,
      "table_cell": 14
