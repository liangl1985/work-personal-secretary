+/**
+ * 桌宠点击/拖动热区：只覆盖形象的**实际渲染框**（等高等宽，尺寸由调用处按
+ * `settings.size` 与 `size * 1.46` 给出，与 PetSprite 内部一致）。
+ *
+ * 为什么单独一层：外层 petFixed 预留了 +128px 宽 / +42px 高（给状态徽章与留白），
+ * 若让整框接管 pointer 事件，形象左右两侧的空白也会响应点击与拖动。
+ * 用独立热区层而不是缩小外层尺寸，是为了**完全不动视觉布局**——
+ * petBob 是绝对定位、徽章在形象下方，外层变矮会把形象整体上移。
+ */
+const petHitbox: CSSProperties = {
+  position: 'relative',
+  pointerEvents: 'auto',
+  cursor: 'pointer',
+  userSelect: 'none',
+}
+
