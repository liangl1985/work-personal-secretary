* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf

# 补丁文件绝不做行尾转换：将来 `git apply` 时要逐字节匹配上下文，
# 被 CRLF 化会让补丁在某些检出场干净应用失败（2026-09-13 发现 0002 有此风险）。
*.patch -text
*.diff -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.zip binary

src/client/pet-action-sheets.generated.ts linguist-generated=true
src/client/pet-asset.generated.ts linguist-generated=true
src/client/pet-idle-sheet.generated.ts linguist-generated=true
